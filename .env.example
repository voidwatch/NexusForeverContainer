# cp .env.example .env  and edit. Keep DB passwords alphanumeric: they go into a connection string unescaped.
DB_ROOT_PASSWORD=change-me-root
DB_USER=nexusforever
DB_PASSWORD=change-me-app

# What game clients are told to connect to for the world server. LAN IP or public DNS name of THIS host.
REALM_HOST=192.168.1.10
REALM_NAME=NexusForever
REALM_ID=1

# Host bind address for the game ports. 0.0.0.0 = all interfaces, or a specific IP.
BIND_IP=0.0.0.0
